          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed (reginitfail)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineWidth",
